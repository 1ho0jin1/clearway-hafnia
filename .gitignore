*.pdf

# Secrets and local settings
.env
.env.*
*.local.*

# Python
__pycache__/
.venv/

# .NET build output
bin/
obj/


# Exported video frames (large; regenerate with scripts\export_frames.ps1)
run/*/frames/
# Frames read back from lens_1's recording (scripts\check_lens.py --export; regenerate)
run/*/recorded/
# The board's clips and snapshots (footage; clips are rebuilt from the lens spool)
run/*/clips/
run/*/snaps/
# The service's scene images for the hotspots (footage too)
run/*/cameras/

# Raw and converted video (large; see data\README for where each clip comes from)
data/*.mp4
data/clips/

# AI City Challenge 2021 Track 4 files: its data licence agreement forbids redistribution
data/aicity21/

# Model weights (downloaded by Ultralytics on first use)
models/
*.pt

# Pipeline pages embed video frames (footage licences not yet recorded)
run/*/pipeline.html

# Lens camera: process logs and the spool of rendered clips (video)
run/lens/
run/board/

# Candidate footage downloaded for evaluation (licences per source in docs/PLAN-near-miss.md)
data/footage/

# Owner inbox (scripts/owner_inbox.py): received notifications carry snapshots (camera footage)
run/inbox/
