*.pdf

# Secrets and local settings
.env
.env.*
*.local.*

# Python
__pycache__/
.venv/
.venv-tts/

# .NET build output
bin/
obj/


# Exported video frames (large; regenerate with scripts\export_frames.ps1)
run/*/frames/
# Frames read back from lens_1's recording (scripts\check_lens.py --export; regenerate)
run/*/recorded/
# The board's clips and snapshots (footage; clips are rebuilt from the lens spool)
run/*/clips/
run/*/snaps/
# The hold-out check's contact sheets (scripts\holdout.py detect; CC0 frames, but bulky: regenerate)
run/*/sheets/
# The same, one folder deeper (run/calib-20261029/holdout-*/, eval-*/: the calibrated-floor test)
run/*/*/frames/
run/*/*/clips/
run/*/*/sheets/
run/holdout-*.detect.out
# The service's scene images for the hotspots (footage too)
run/*/cameras/

# Old runs, 10/23 to 10/27: the detector sweeps, the dry runs and the first live runs. What is left in them is
# logs (stdout/stderr, pickled events, the records of a run that a later one superseded); the files of theirs
# that were committed stay tracked. Runs from 10/28 on are not covered: add a folder here by name if it is a log too.
run/change-20261023T124841Z/
run/change-dev*/
run/change-g1-real-15/
run/change-g1-real-30/
run/change-g1-synthetic/
run/change-persist*/
run/change-vandalism-*/
run/clearway-dry-2026102[5-7]T*/
run/clearway-live-2026102[5-7]T*/
run/ledger-dev/
run/ledger-escalate-check/
run/ledger-F1*/
run/memory-p1.5/
run/notify-test/

# Raw and converted video (large; see data\README for where each clip comes from)
data/*.mp4
data/clips/

# AI City Challenge 2021 Track 4 files: its data licence agreement forbids redistribution
data/aicity21/

# Model weights (downloaded by Ultralytics on first use)
models/
*.pt

# Pipeline pages embed video frames (footage licences not yet recorded)
run/*/pipeline.html

# Lens camera: process logs and the spool of rendered clips (video)
run/lens/
run/board/

# Candidate footage downloaded for evaluation (the held-out clips' licences and checksums are in scripts/fetch_footage.py)
data/footage/

# Owner inbox (scripts/owner_inbox.py): received notifications carry snapshots (camera footage)
run/inbox/

# The demonstration video and its footage (scripts/make_video.py, record_board.py); the card pages are kept
docs/video/board/
docs/video/render/
docs/video/audio/
docs/video/voice/
docs/video/segments/
docs/video/captures/*
docs/video/*.mp4
# The finished cut is kept (organizers' cameras and our own pages only): the README links it, with poster.jpg;
# so is the terminal card's text (the filmed run's first lines)
!docs/video/clearway.mp4
!docs/video/captures/plan.txt

# The rev. 3 video kit (docs/video-rev3, 2026-11-02): its script, tools, cards and shot lists are tracked; the footage
# (captures, the phone recording, the previews), the narration, the segments, the cuts and the zip it came in are not
docs/video-rev3/visuals/*.mp4
docs/video-rev3/preview/
docs/video-rev3/audio/*
docs/video-rev3/voice/*
docs/video-rev3/segments/
docs/video-rev3/*.mp4
!docs/video-rev3/audio/README.txt
!docs/video-rev3/voice/README.txt
docs/*.zip

# Run logs stay local (removed before the repository went public, 2026-11-02); each run's README keeps the numbers.
# The hold-out's hand-made labels stay: the reproduce steps copy them.
run/**/*.json
run/**/*.jsonl
run/**/*.log
run/**/*.err
run/**/*.pkl
run/**/*.npz
!run/holdout-20261029/labels.json
